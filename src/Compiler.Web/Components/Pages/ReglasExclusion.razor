@page "/reglas-exclusion"
@using static Compiler.Domain.Enums.Enumeraciones

<PageTitle>Reglas Exclusion</PageTitle>

<h1>Reglas de exclusión</h1>

<div class="row g-3 mb-3">
    <div class="col-md-8">
        <label class="form-label" for="textoExclusion">Texto</label>
        <input id="textoExclusion" class="form-control" @bind="nuevoTexto" placeholder="Extension, nombre o nombre completo" />
    </div>
    <div class="col-md-4">
        <label class="form-label" for="tipoExclusion">Tipo</label>
        <select id="tipoExclusion" class="form-select" @bind="nuevoTipo">
            @foreach (var tipo in tipos)
            {
                <option value="@tipo.Id">@tipo.Descripcion</option>
            }
        </select>
    </div>
</div>

<div class="d-flex gap-2 mb-3">
    <button class="btn btn-primary" @onclick="CrearRegla" disabled="@string.IsNullOrWhiteSpace(nuevoTexto)">Crear regla</button>
    <button class="btn btn-outline-secondary" @onclick="Limpiar">Limpiar</button>
</div>

@if (!string.IsNullOrWhiteSpace(mensaje))
{
    <div class="alert @(error ? "alert-danger" : "alert-info")" role="alert">@mensaje</div>
}

@if (reglas.Count == 0)
{
    <p>No hay reglas de exclusión cargadas.</p>
}
else
{
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Texto</th>
                <th>Tipo</th>
                <th style="width: 120px;">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var regla in reglas)
            {
                <tr>
                    <td>@regla.texto</td>
                    <td>@regla.tipoExclusion</td>
                    <td>
                        <button class="btn btn-sm btn-outline-danger" @onclick="() => BorrarRegla(regla.id)">Borrar</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    [Inject] private IArchivoExclusionService ExclusionService { get; set; } = default!;
    [Inject] private IAplicacionService AplicacionService { get; set; } = default!;

    private List<ArchivoExclusion> reglas = [];
    private List<Compiler.Domain.Enums.EnumBase> tipos = getListTipoExclusionAdmision();
    private string nuevoTexto = string.Empty;
    private int nuevoTipo;
    private string mensaje = string.Empty;
    private bool error;

    protected override void OnInitialized()
    {
        Cargar();
    }

    private void Cargar()
    {
        reglas = ExclusionService.GetArchivoExclusiones();
    }

    private void CrearRegla()
    {
        var texto = nuevoTexto.Trim();
        if (string.IsNullOrWhiteSpace(texto))
        {
            mensaje = "El texto es obligatorio.";
            error = true;
            return;
        }

        ExclusionService.ModificarArchivoExclusion(new ArchivoExclusion
        {
            texto = texto,
            tipoExclusion = nuevoTipo
        });

        mensaje = "Regla de exclusión creada.";
        error = false;
        Limpiar();
        Cargar();
    }

    private void BorrarRegla(Guid id)
    {
        if (!ExclusionService.ExisteArchivoExclusion(id))
        {
            mensaje = "La regla ya no existe.";
            error = true;
            Cargar();
            return;
        }

        if (AplicacionService.AnyAplicacionConArchivoExclusion(id))
        {
            mensaje = "No se puede borrar la regla porque está asociada a una aplicación.";
            error = true;
            return;
        }

        ExclusionService.BorrarArchivoExclusion(id);
        mensaje = "Regla eliminada.";
        error = false;
        Cargar();
    }

    private void Limpiar()
    {
        nuevoTexto = string.Empty;
        nuevoTipo = 0;
    }
}
