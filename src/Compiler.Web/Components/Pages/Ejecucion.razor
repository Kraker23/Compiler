@page "/ejecucion"

<PageTitle>Ejecucion</PageTitle>

<h1>Ejecucion</h1>

<div class="mb-3">
    <label class="form-label" for="proyecto">Proyecto</label>
    <select id="proyecto" class="form-select" @bind="proyectoSeleccionadoId">
        <option value="">Selecciona un proyecto</option>
        @foreach (var proyecto in proyectos)
        {
            <option value="@proyecto.id">@proyecto.nombre</option>
        }
    </select>
</div>

<div class="d-flex gap-2">
    <button class="btn btn-success" @onclick="CopiarProyecto" disabled="@(!proyectoSeleccionadoId.HasValue || ejecutando)">
        @(ejecutando ? "Ejecutando..." : "Copiar Proyecto")
    </button>
    <button class="btn btn-primary" @onclick="CompilarProyecto" disabled="@(!proyectoSeleccionadoId.HasValue || ejecutando)">
        @(ejecutando ? "Ejecutando..." : "Compilar Proyecto")
    </button>
    <button class="btn btn-warning" @onclick="CompilarYCopiarProyecto" disabled="@(!proyectoSeleccionadoId.HasValue || ejecutando)">
        @(ejecutando ? "Ejecutando..." : "Compilar y Copiar")
    </button>
</div>

@if (!string.IsNullOrWhiteSpace(resultadoMensaje))
{
    <div class="alert @(resultadoExito ? "alert-success" : "alert-danger") mt-3" role="alert">
        @resultadoMensaje
    </div>
}

@if (pasos.Count > 0)
{
    <h2 class="h5 mt-4">Detalle de ejecucion</h2>
    <ul class="list-group">
        @foreach (var paso in pasos)
        {
            <li class="list-group-item">
                <div><strong>Comando:</strong> @paso.Command</div>
                <div><strong>ExitCode:</strong> @paso.ExitCode</div>
                @if (!string.IsNullOrWhiteSpace(paso.Error))
                {
                    <div class="text-danger"><strong>Error:</strong> @paso.Error</div>
                }
            </li>
        }
    </ul>
}

@code {
    [Inject] private IProyectoService ProyectoService { get; set; } = default!;
    [Inject] private ITaskRunnerService TaskRunnerService { get; set; } = default!;

    private List<Proyecto> proyectos = [];
    private Guid? proyectoSeleccionadoId;
    private bool ejecutando;
    private bool resultadoExito;
    private string resultadoMensaje = string.Empty;
    private List<Compiler.Application.Contracts.Execution.CommandExecutionResult> pasos = [];

    protected override void OnInitialized()
    {
        proyectos = ProyectoService.GetProyectos();
    }

    private async Task CopiarProyecto()
    {
        await Ejecutar(async id => await TaskRunnerService.CopyProyectoAsync(id));
    }

    private async Task CompilarProyecto()
    {
        await Ejecutar(async id => await TaskRunnerService.BuildProyectoAsync(id));
    }

    private async Task CompilarYCopiarProyecto()
    {
        await Ejecutar(async id => await TaskRunnerService.BuildAndCopyProyectoAsync(id));
    }

    private async Task Ejecutar(Func<Guid, Task<Compiler.Application.Contracts.Execution.TaskExecutionResult>> action)
    {
        if (!proyectoSeleccionadoId.HasValue)
        {
            return;
        }

        ejecutando = true;
        resultadoMensaje = string.Empty;
        pasos = [];

        try
        {
            var result = await action(proyectoSeleccionadoId.Value);
            resultadoExito = result.Success;
            resultadoMensaje = result.Message;
            pasos = result.Steps;
        }
        finally
        {
            ejecutando = false;
        }
    }
}
